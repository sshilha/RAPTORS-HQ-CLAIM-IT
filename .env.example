# Copy this file to .env and fill it in. Railway sets these in its Variables tab instead.

# Database. Local Docker (npm run db):   postgres://raptors:raptors@localhost:5432/claimit
# Railway: reference your Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://raptors:raptors@localhost:5432/claimit

# Address people use to reach the app (no trailing slash). Used in sign-in links and emails.
# On your computer: http://localhost:3000
# To test from your phone on the same Wi-Fi: http://YOUR-COMPUTER-IP:3000
APP_URL=http://localhost:3000

# Email via Resend (https://resend.com). Leave RESEND_API_KEY blank while testing:
# sign-in links are then printed in the terminal instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Raptors Claim It <training@chippewavalleyraptors.com>

# Testing only: show the sign-in link right on the "check your email" screen.
# Never set this to true once real families are using the app.
DEV_SHOW_LINK=true

# Comma-separated emails that are always admins
ADMIN_EMAILS=you@example.com

# Optional: Google address search in ⚙ App → Locations
GOOGLE_MAPS_API_KEY=
